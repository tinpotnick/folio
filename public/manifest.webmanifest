{
  "name": "folio",
  "short_name": "folio",
  "description": "Documents where the data lives inside, and the page looks finished. A folio document is one plain Markdown file.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f3f4f6",
  "theme_color": "#f3f4f6",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "name": "Markdown document",
      "accept": {
        "text/markdown": [".md", ".markdown"],
        "text/x-markdown": [".md", ".markdown"]
      }
    }
  ]
}
