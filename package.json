{
  "name": "folio",
  "version": "0.0.1",
  "description": "Document-first workspace: semantic Markdown docs with typed datasets, query-driven charts, publication-quality output.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests && prettier --check src tests",
    "format": "prettier --write src tests",
    "build": "tsc --noEmit && vite build",
    "ci": "npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^26.6.5",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vite": "^6.0.1",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.4"
  }
}
