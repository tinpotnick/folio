{
  "name": "folio",
  "version": "0.0.1",
  "description": "Document-first workspace: semantic Markdown docs with typed datasets, query-driven charts, publication-quality output.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "dev:desktop": "tauri dev",
    "build:desktop": "tauri build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests && prettier --check src tests",
    "format": "prettier --write src tests",
    "build": "tsc --noEmit && vite build",
    "ci": "npm run lint && npm test && npm run build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/eb-garamond": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/libre-franklin": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@jscad/modeling": "^2.13.0",
    "@tauri-apps/api": "^2",
    "@viz-js/viz": "^3.31.0",
    "abcjs": "^6.7.2",
    "highlight.js": "^11.12.0",
    "jexl": "^2.3.0",
    "katex": "^0.19.0",
    "mermaid": "^12.2.0",
    "vega": "^6.4.0",
    "vega-lite": "^6.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.64.1",
    "@strudel/web": "^1.3.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.5",
    "eslint": "^9.14.0",
    "happy-dom": "^21.0.3",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vite": "^6.0.1",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.4"
  }
}
