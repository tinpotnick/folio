{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "folio",
  "mainBinaryName": "folio",
  "version": "0.1.0",
  "identifier": "io.github.tinpotnick.folio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "folio",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Documents where the data lives inside, and the page looks finished.",
    "longDescription": "folio is a document editor where tables are live datasets, charts are drawn from them, and every document renders as a polished report from a plain Markdown file anyone can read.",
    "publisher": "Nick Knight",
    "copyright": "Copyright (c) 2026 Nick Knight. MIT licence.",
    "license": "MIT",
    "licenseFile": "../../../LICENSE",
    "homepage": "https://github.com/tinpotnick/folio",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
